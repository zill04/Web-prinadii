<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Personal Website | Our Story</title>

    <!-- GOOGLE FONT -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    <style>

        /* =========================
           RESET
        ========================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "DM Sans", sans-serif;
            background: #faf9f7;
            color: #292624;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }


        /* =========================
           VARIABLES
        ========================= */

        :root {
            --primary: #8b6f5a;
            --primary-dark: #624b3d;
            --cream: #f7f2ed;
            --cream-dark: #eee4da;
            --white: #ffffff;
            --text: #292624;
            --text-light: #756e69;
            --shadow: 0 15px 40px rgba(80, 62, 49, 0.10);
        }


        /* =========================
           NAVBAR
        ========================= */

        nav {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            max-width: 1150px;

            padding: 15px 25px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            background: rgba(255,255,255,0.82);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);

            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 50px;

            box-shadow: 0 10px 35px rgba(0,0,0,0.08);

            z-index: 1000;
        }


        .logo {
            font-family: "Playfair Display", serif;
            font-size: 22px;
            font-weight: 700;
            color: var(--primary-dark);
        }


        nav ul {
            display: flex;
            list-style: none;
            gap: 8px;
        }


        nav ul li a {
            display: block;

            padding: 10px 16px;

            color: #4b4541;
            font-size: 14px;
            font-weight: 600;

            border-radius: 25px;

            transition: 0.3s ease;
        }


        nav ul li a:hover {
            background: var(--primary);
            color: white;
        }


        /* =========================
           HOME
        ========================= */

        #home {
            min-height: 100vh;

            padding: 150px 9% 80px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 70px;

            background:
                radial-gradient(circle at 10% 20%, #eaded3 0, transparent 25%),
                radial-gradient(circle at 90% 80%, #e7d9ce 0, transparent 25%),
                #faf9f7;
        }


        .home-text {
            max-width: 620px;
        }


        .small-title {
            display: inline-block;

            padding: 8px 16px;
            margin-bottom: 20px;

            background: #eee5dd;
            color: var(--primary-dark);

            border-radius: 30px;

            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1px;
        }


        .home-text h1 {
            font-family: "Playfair Display", serif;

            font-size: clamp(45px, 6vw, 78px);
            line-height: 1.08;

            margin-bottom: 25px;
        }


        .home-text h1 span {
            color: var(--primary);
            font-style: italic;
        }


        .home-text p {
            color: var(--text-light);

            font-size: 17px;
            line-height: 1.9;

            max-width: 550px;

            margin-bottom: 32px;
        }


        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;

            padding: 14px 25px;

            background: var(--primary-dark);
            color: white;

            border-radius: 35px;

            font-weight: 600;

            box-shadow: 0 10px 25px rgba(98,75,61,0.2);

            transition: 0.3s ease;
        }


        .btn:hover {
            transform: translateY(-4px);
            background: var(--primary);
            box-shadow: 0 15px 30px rgba(98,75,61,0.3);
        }


        /* =========================
           HOME PHOTOS
        ========================= */

        .home-photo {
            position: relative;

            display: flex;
            align-items: center;
            justify-content: center;

            min-width: 440px;
            height: 450px;
        }


        .home-photo::before {
            content: "";

            position: absolute;

            width: 330px;
            height: 330px;

            background: #e8d9cc;

            border-radius: 50%;

            z-index: 0;
        }


        .home-photo img {
            position: relative;

            width: 205px;
            height: 280px;

            object-fit: cover;

            border: 8px solid white;
            border-radius: 110px 110px 25px 25px;

            box-shadow: var(--shadow);

            transition: 0.4s ease;
        }


        .home-photo img:first-child {
            transform: rotate(-7deg) translateX(25px);
            z-index: 2;
        }


        .home-photo img:last-child {
            transform: rotate(7deg) translateX(-25px);
            z-index: 1;
        }


        .home-photo img:hover {
            transform: translateY(-15px) scale(1.03);
            z-index: 5;
        }


        /* =========================
           SECTION
        ========================= */

        section {
            padding: 110px 9%;
        }


        .section-label {
            text-align: center;

            color: var(--primary);

            font-size: 13px;
            font-weight: 700;

            letter-spacing: 3px;

            text-transform: uppercase;

            margin-bottom: 10px;
        }


        .judul {
            text-align: center;

            font-family: "Playfair Display", serif;

            font-size: clamp(35px, 5vw, 50px);

            margin-bottom: 60px;

            color: var(--text);
        }


        .judul span {
            color: var(--primary);
            font-style: italic;
        }


        /* =========================
           PROFILE
        ========================= */

        #profil {
            background: var(--white);
        }


        .container {
            display: flex;
            justify-content: center;
            gap: 35px;
            flex-wrap: wrap;
        }


        .card {
            position: relative;

            width: 380px;

            padding: 35px;

            background: #fff;

            border: 1px solid #eee7e1;

            border-radius: 30px;

            text-align: center;

            box-shadow: var(--shadow);

            overflow: hidden;

            transition: 0.4s ease;
        }


        .card::before {
            content: "";

            position: absolute;

            top: 0;
            left: 0;

            width: 100%;
            height: 6px;

            background: var(--primary);
        }


        .card:hover {
            transform: translateY(-12px);
            box-shadow: 0 25px 50px rgba(80,62,49,0.15);
        }


        .card img {
            width: 165px;
            height: 165px;

            object-fit: cover;

            border-radius: 50%;

            border: 7px solid #f0e7df;

            margin-bottom: 20px;
        }


        .card h2 {
            font-family: "Playfair Display", serif;

            font-size: 27px;

            margin-bottom: 25px;

            color: var(--primary-dark);
        }


        .biodata {
            text-align: left;

            padding-top: 10px;

            border-top: 1px solid #eee5de;
        }


        .biodata p {
            padding: 10px 0;

            color: var(--text-light);

            border-bottom: 1px dashed #eee5de;

            line-height: 1.6;
        }


        .biodata p:last-child {
            border-bottom: none;
        }


        .biodata b {
            color: var(--text);
        }


        /* =========================
           ACTIVITY
        ========================= */

        #activity {
            background: var(--cream);
        }


        .activity-card {
            width: 300px;

            background: white;

            border-radius: 25px;

            overflow: hidden;

            box-shadow: var(--shadow);

            transition: 0.4s ease;
        }


        .activity-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 25px 50px rgba(80,62,49,0.15);
        }


        .activity-card img {
            width: 100%;
            height: 210px;

            object-fit: cover;

            transition: 0.5s ease;
        }


        .activity-card:hover img {
            transform: scale(1.07);
        }


        .activity-image {
            overflow: hidden;
        }


        .activity-text {
            padding: 25px;
        }


        .activity-number {
            color: #b7a193;

            font-size: 12px;
            font-weight: 700;

            letter-spacing: 2px;

            margin-bottom: 8px;
        }


        .activity-text h3 {
            font-family: "Playfair Display", serif;

            font-size: 25px;

            color: var(--primary-dark);

            margin-bottom: 12px;
        }


        .activity-text p {
            color: var(--text-light);

            line-height: 1.8;
        }


        /* =========================
           LATAR BELAKANG
        ========================= */

        #latar {
            background: white;
        }


        .background-wrapper {
            max-width: 1000px;
            margin: auto;
        }


        .background-card {
            position: relative;

            display: grid;
            grid-template-columns: 200px 1fr;

            gap: 40px;

            padding: 35px;

            margin-bottom: 30px;

            background: #faf8f5;

            border: 1px solid #eee7e1;

            border-radius: 25px;

            transition: 0.3s ease;
        }


        .background-card:hover {
            transform: translateX(8px);
            box-shadow: var(--shadow);
        }


        .background-card h2 {
            font-family: "Playfair Display", serif;

            color: var(--primary-dark);

            font-size: 28px;
        }


        .background-card p {
            color: var(--text-light);

            line-height: 1.9;
        }


        /* =========================
           QUOTE
        ========================= */

        .quote {
            max-width: 800px;

            margin: 70px auto 0;

            text-align: center;
        }


        .quote p {
            font-family: "Playfair Display", serif;

            font-size: 27px;
            line-height: 1.6;

            color: var(--primary-dark);

            font-style: italic;
        }


        .quote span {
            display: block;

            margin-top: 15px;

            color: var(--text-light);

            font-size: 14px;
        }


        /* =========================
           FOOTER
        ========================= */

        footer {
            padding: 50px 20px;

            background: #302a27;

            color: white;

            text-align: center;
        }


        footer h2 {
            font-family: "Playfair Display", serif;

            font-size: 28px;

            margin-bottom: 10px;
        }


        footer p {
            color: #cfc7c2;

            line-height: 1.8;
        }


        .footer-line {
            width: 60px;
            height: 2px;

            background: #a68c79;

            margin: 20px auto;
        }


        /* =========================
           SCROLL REVEAL
        ========================= */

        .card,
        .activity-card,
        .background-card {
            animation: fadeUp 0.8s ease both;
        }


        @keyframes fadeUp {

            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }


        /* =========================
           RESPONSIVE
        ========================= */

        @media(max-width: 900px) {

            nav {
                width: 94%;
            }


            #home {
                flex-direction: column;

                text-align: center;

                padding-top: 150px;
            }


            .home-text p {
                margin-left: auto;
                margin-right: auto;
            }


            .home-photo {
                min-width: auto;
            }

        }


        @media(max-width: 650px) {

            nav {
                position: fixed;

                top: 10px;

                padding: 12px 15px;

                flex-direction: column;

                gap: 5px;

                border-radius: 25px;
            }


            .logo {
                font-size: 18px;
            }


            nav ul {
                gap: 2px;

                flex-wrap: wrap;

                justify-content: center;
            }


            nav ul li a {
                padding: 7px 9px;

                font-size: 11px;
            }


            #home {
                padding: 160px 6% 70px;
            }


            .home-text h1 {
                font-size: 42px;
            }


            .home-text p {
                font-size: 15px;
            }


            .home-photo {
                width: 100%;
                height: 350px;
            }


            .home-photo::before {
                width: 260px;
                height: 260px;
            }


            .home-photo img {
                width: 145px;
                height: 210px;
            }


            section {
                padding: 80px 6%;
            }


            .card {
                width: 100%;
                padding: 28px 22px;
            }


            .activity-card {
                width: 100%;
            }


            .background-card {
                grid-template-columns: 1fr;

                gap: 15px;

                padding: 25px;
            }


            .quote p {
                font-size: 22px;
            }

        }

    </style>
</head>


<body>


