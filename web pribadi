    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        // Efek navbar saat halaman di-scroll

        window.addEventListener("scroll", function() {

            const nav = document.querySelector("nav");

            if (window.scrollY > 50) {

                nav.style.boxShadow =
                    "0 15px 35px rgba(0,0,0,0.12)";

            } else {

                nav.style.boxShadow =
